{
  "name": "partner-conformance-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A conformance suite a provider runs against a partner's implementation of its API: signed requests in, a verdict per case out.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:partner": "pnpm --filter @conformance/partner dev",
    "test": "pnpm -r --sequential test",
    "lint": "eslint . && pnpm --filter @conformance/spec lint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "check:leak": "node scripts/check-leak.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm check:leak && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
